# Database
POSTGRES_USER=clinic_user
POSTGRES_PASSWORD=clinic_password
POSTGRES_DB=clinic_db

# API
PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://clinic_user:clinic_password@localhost:5432/clinic_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# Frontend
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:3001

# Backup
# How many days of daily backups to keep locally before auto-deleting them.
BACKUP_RETENTION_DAYS=14
# Base64 or hex-encoded 32-byte key. Required in production.
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_REQUIRED=false
# Optional: off-server storage for backups (any S3-compatible provider —
# AWS S3, Backblaze B2, DigitalOcean Spaces, MinIO, etc). Leave all four
# blank to skip remote upload; backups still work, they just stay local
# only (at ./backups on the host).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=us-east-1
